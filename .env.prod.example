# Copy to .env.prod on the server and fill in secrets.
# NEVER commit .env.prod to git.

DOMAIN=quazar-msg.ru

# Strong random password for PostgreSQL
POSTGRES_USER=quazar
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=quazar

# Strong random secret for JWT (e.g. openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET

# Frontend origins allowed by CORS
CORS_ORIGINS=https://quazar-msg.ru,https://www.quazar-msg.ru

# Email for Let's Encrypt expiry notices
LETSENCRYPT_EMAIL=you@example.com
