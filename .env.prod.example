# Copy to .env.prod on the server and fill in secrets.
# NEVER commit .env.prod to git.

DOMAIN=quazar-msg.ru

# Strong random password for PostgreSQL
POSTGRES_USER=quazar
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=quazar

# Strong random secret for JWT (e.g. openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET

# Frontend origins allowed by CORS
CORS_ORIGINS=https://quazar-msg.ru,https://www.quazar-msg.ru

# Подтверждение регистрации звонком. При заданных ключе/кампании обязательно для новых аккаунтов.
ZVONOK_API_KEY=
ZVONOK_CAMPAIGN_ID=
ZVONOK_DAILY_LIMIT=500

# Email for Let's Encrypt expiry notices
LETSENCRYPT_EMAIL=you@example.com

# --- WebRTC TURN (calls Part 1) — see docs/WEBRTC-TURN.md ---
# Public IPv4 of this VM (required for coturn behind NAT)
# TURN_EXTERNAL_IP=203.0.113.10
# TURN_REALM=quazar-msg.ru
# WEBRTC_STUN_URLS=stun:quazar-msg.ru:3478,stun:stun.l.google.com:19302
# WEBRTC_TURN_URLS=turn:quazar-msg.ru:3478?transport=udp,turn:quazar-msg.ru:3478?transport=tcp
# WEBRTC_TURN_USERNAME=quazar
# WEBRTC_TURN_CREDENTIAL=generate_with_openssl_rand_hex_24

# Web Push VAPID (calls Part 2) — generate on Mac: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@quazar-msg.ru
# CALL_RING_TIMEOUT_SEC=45

# --- Голос на Планетах (LiveKit) — see docs/VOICE-PLANETS.md ---
# Генерируются автоматически при деплое (deploy/scripts/render-livekit-config.sh), если их нет.
# Не меняйте после запуска: активные разговоры оборвутся.
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Порты в фаерволе сервера и в панели хостинга: 7881/tcp и 7882/udp.

# --- Файлы пользователей на отдельном диске — см. docs/DEPLOY.md («Файлы на отдельном диске») ---
# Задаёт deploy/scripts/move-media-to-hdd.sh. Пусто — docker-том media_data.
# MEDIA_DIR=/srv/hdd/quazar/media
# MEDIA_MARKER=.quazar-media

# --- Вход в Padma через Квазар — см. docs/PADMA-SSO.md ---
# Пусто — /oauth/* отвечают 404. Секрет: python3 -c "import secrets; print(secrets.token_urlsafe(32))",
# тот же — в QUAZAR_CLIENT_SECRET у Padma. Адреса возврата — через запятую, точное совпадение.
# PADMA_OAUTH_CLIENT_ID=padma
# PADMA_OAUTH_CLIENT_SECRET=
# PADMA_OAUTH_REDIRECT_URIS=https://www.padma.ru/api/auth/quazar/callback

# --- Расшифровка голосовых через Cloudflare Workers AI — docs/TRANSCRIPTION.md ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ASR_MODEL=@cf/openai/whisper-large-v3-turbo
TRANSCRIPTION_USER_MINUTES_PER_DAY=30
TRANSCRIPTION_TOTAL_MINUTES_PER_DAY=180
