# Copy to .env.prod on the server and fill in secrets.
# NEVER commit .env.prod to git.

DOMAIN=quazar-msg.ru

# Strong random password for PostgreSQL
POSTGRES_USER=quazar
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=quazar

# Strong random secret for JWT (e.g. openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET

# Frontend origins allowed by CORS
CORS_ORIGINS=https://quazar-msg.ru,https://www.quazar-msg.ru

# Email for Let's Encrypt expiry notices
LETSENCRYPT_EMAIL=you@example.com

# --- WebRTC TURN (calls Part 1) — see docs/WEBRTC-TURN.md ---
# Public IPv4 of this VM (required for coturn behind NAT)
# TURN_EXTERNAL_IP=203.0.113.10
# TURN_REALM=quazar-msg.ru
# WEBRTC_STUN_URLS=stun:quazar-msg.ru:3478,stun:stun.l.google.com:19302
# WEBRTC_TURN_URLS=turn:quazar-msg.ru:3478?transport=udp,turn:quazar-msg.ru:3478?transport=tcp
# WEBRTC_TURN_USERNAME=quazar
# WEBRTC_TURN_CREDENTIAL=generate_with_openssl_rand_hex_24

# Web Push VAPID (calls Part 2) — generate on Mac: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@quazar-msg.ru
# CALL_RING_TIMEOUT_SEC=45
