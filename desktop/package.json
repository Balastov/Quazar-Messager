{
  "name": "quazar-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "Quazar desktop client",
  "author": "Quazar",
  "license": "UNLICENSED",
  "main": "src/main.cjs",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "prepare:renderer": "node scripts/prepare-renderer.cjs",
    "start": "npm run prepare:renderer && electron .",
    "pack": "npm run prepare:renderer && electron-builder --dir --publish never",
    "build:mac": "npm run prepare:renderer && electron-builder --mac --arm64 --x64 --publish never",
    "build:win": "npm run prepare:renderer && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "js-yaml": "4.3.2"
  },
  "build": {
    "appId": "ru.quazar.messenger",
    "productName": "Quazar",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "icon": "renderer/icons/icon-512.png",
    "artifactName": "Quazar-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://quazar-msg.ru/desktop-updates/${os}-${arch}/"
      }
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "identity": "-",
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Quazar использует микрофон для звонков и общения в комнатах.",
        "NSCameraUsageDescription": "Quazar использует камеру для видеозвонков.",
        "NSAudioCaptureUsageDescription": "Quazar передаёт звук компьютера при демонстрации экрана, если вы это разрешили."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "protocols": [
      {
        "name": "Quazar desktop",
        "schemes": [
          "quazar-desktop"
        ]
      }
    ]
  }
}
